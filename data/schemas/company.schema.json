{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechCompetitionHub company",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "is_example": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "industry": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "website": {
      "type": "string",
      "minLength": 1
    },
    "careers_url": {
      "type": "string",
      "minLength": 1
    },
    "role_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "competition_preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competition_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "direct_channel",
              "priority",
              "plus",
              "no_public_channel",
              "unknown"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1200
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          },
          "accessed_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "competition_id",
          "status",
          "statement",
          "source_url",
          "accessed_at",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "hiring_programs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 600
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "description",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 240
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "source_type": {
            "type": "string",
            "enum": [
              "official",
              "organizer",
              "institutional",
              "news",
              "community",
              "research"
            ]
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "accessed_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "supports": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "source_type",
          "published_at",
          "accessed_at",
          "supports",
          "confidence",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "verified",
        "stale",
        "rejected"
      ]
    },
    "last_verified_at": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "is_example",
    "id",
    "name",
    "aliases",
    "industry",
    "website",
    "careers_url",
    "role_ids",
    "competition_preferences",
    "hiring_programs",
    "sources",
    "verification_status",
    "last_verified_at",
    "updated_at",
    "notes"
  ],
  "additionalProperties": false
}
