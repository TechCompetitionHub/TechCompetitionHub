{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechCompetitionHub roadmap",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "is_example": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "goal_type": {
      "type": "string",
      "enum": [
        "competition",
        "skill_direction",
        "project"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "target_competition_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "target_project_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "target_skill_levels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "target_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "required": [
          "skill_id",
          "target_level"
        ],
        "additionalProperties": false
      }
    },
    "phases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "goal": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          },
          "task_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "goal",
          "task_ids"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "skill_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "goal": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          },
          "deliverables": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "acceptance_criteria": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "estimated_hours": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "skill_id",
          "goal",
          "deliverables",
          "acceptance_criteria",
          "estimated_hours"
        ],
        "additionalProperties": false
      }
    },
    "estimated_hours": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptance_criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "assumptions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "schema_version",
    "is_example",
    "id",
    "title",
    "goal_type",
    "summary",
    "target_competition_ids",
    "target_project_ids",
    "target_skill_levels",
    "phases",
    "tasks",
    "estimated_hours",
    "acceptance_criteria",
    "resource_ids",
    "assumptions",
    "version",
    "updated_at"
  ],
  "additionalProperties": false
}
