{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechCompetitionHub resource",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "is_example": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "documentation",
        "course",
        "book",
        "tool",
        "dataset",
        "article",
        "video",
        "community"
      ]
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "domains": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "related_skill_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "license_or_access_terms": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500
    },
    "free_status": {
      "type": "string",
      "enum": [
        "free",
        "freemium",
        "paid",
        "unknown"
      ]
    },
    "last_checked_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "is_example",
    "id",
    "title",
    "resource_type",
    "url",
    "language",
    "level",
    "domains",
    "related_skill_ids",
    "publisher",
    "license_or_access_terms",
    "free_status",
    "last_checked_at",
    "notes"
  ],
  "additionalProperties": false
}
