{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechCompetitionHub skill",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "is_example": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "levels": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "behavior": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1000
          }
        },
        "required": [
          "level",
          "label",
          "behavior"
        ],
        "additionalProperties": false
      }
    },
    "prerequisite_skill_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "practice_tasks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "goal": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          },
          "prerequisites": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "deliverables": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "acceptance_criteria": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "estimated_hours": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "common_failures": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          }
        },
        "required": [
          "id",
          "title",
          "level",
          "goal",
          "prerequisites",
          "steps",
          "deliverables",
          "acceptance_criteria",
          "estimated_hours",
          "common_failures"
        ],
        "additionalProperties": false
      }
    },
    "resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "related_competition_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "related_project_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 240
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "source_type": {
            "type": "string",
            "enum": [
              "official",
              "organizer",
              "institutional",
              "news",
              "community",
              "research"
            ]
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "accessed_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "supports": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "source_type",
          "published_at",
          "accessed_at",
          "supports",
          "confidence",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "maintainer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "schema_version",
    "is_example",
    "id",
    "name",
    "domain",
    "definition",
    "levels",
    "prerequisite_skill_ids",
    "practice_tasks",
    "resource_ids",
    "related_competition_ids",
    "related_project_ids",
    "sources",
    "maintainer",
    "updated_at"
  ],
  "additionalProperties": false
}
