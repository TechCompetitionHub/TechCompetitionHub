{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechCompetitionHub competition",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "is_example": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "organizers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "role": {
            "type": "string",
            "enum": [
              "host",
              "organizer",
              "co-organizer",
              "secretariat",
              "sponsor"
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "role",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "domains": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "description": {
      "type": "string",
      "minLength": 50,
      "maxLength": 6000
    },
    "audience": {
      "type": "object",
      "properties": {
        "levels": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "levels",
        "notes"
      ],
      "additionalProperties": false
    },
    "format": {
      "type": "object",
      "properties": {
        "team_based": {
          "type": "boolean"
        },
        "team_size": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "min": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "max": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery_modes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "online",
              "offline",
              "hybrid"
            ]
          }
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "team_based",
        "team_size",
        "delivery_modes",
        "notes"
      ],
      "additionalProperties": false
    },
    "difficulty": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "rationale": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        }
      },
      "required": [
        "level",
        "rationale"
      ],
      "additionalProperties": false
    },
    "estimated_cost": {
      "type": "object",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "free",
            "verified",
            "estimated",
            "unknown",
            "not_applicable"
          ]
        },
        "basis": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "amount",
        "currency",
        "status",
        "basis",
        "notes"
      ],
      "additionalProperties": false
    },
    "skills_required": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "target_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "required": [
          "skill_id",
          "target_level"
        ],
        "additionalProperties": false
      }
    },
    "schedule": {
      "type": "object",
      "properties": {
        "registration_start": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "registration_end": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_start": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_end": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "partial",
            "expected",
            "unknown",
            "not_applicable"
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "registration_start",
        "registration_end",
        "event_start",
        "event_end",
        "status",
        "notes"
      ],
      "additionalProperties": false
    },
    "official_urls": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 240
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "source_type": {
            "type": "string",
            "enum": [
              "official",
              "organizer",
              "institutional",
              "news",
              "community",
              "research"
            ]
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "accessed_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "supports": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "source_type",
          "published_at",
          "accessed_at",
          "supports",
          "confidence",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "external_lists": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "publisher": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300
          },
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
          },
          "category": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "accessed_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "publisher",
          "year",
          "category",
          "url",
          "accessed_at",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "verified",
        "stale",
        "rejected"
      ]
    },
    "last_verified_at": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scoring_model_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "scores": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "model_version": {
              "type": "string",
              "minLength": 1
            },
            "dimension_scores": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 2000
                  },
                  "evidence_level": {
                    "type": "string",
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  }
                },
                "required": [
                  "score",
                  "rationale",
                  "evidence_level"
                ],
                "additionalProperties": false
              }
            },
            "weighted_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "evidence_summary": {
              "type": "string",
              "minLength": 20,
              "maxLength": 4000
            },
            "sample_size": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "confidence_level": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "review_status": {
              "type": "string",
              "enum": [
                "draft",
                "in_review",
                "approved"
              ]
            },
            "reviewed_at": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reviewer_role": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 160
                },
                {
                  "type": "null"
                }
              ]
            },
            "notes": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "model_version",
            "dimension_scores",
            "weighted_score",
            "evidence_summary",
            "sample_size",
            "confidence_level",
            "review_status",
            "reviewed_at",
            "reviewer_role",
            "notes"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "is_example",
    "id",
    "name",
    "aliases",
    "organizers",
    "domains",
    "summary",
    "description",
    "audience",
    "format",
    "difficulty",
    "estimated_cost",
    "skills_required",
    "schedule",
    "official_urls",
    "sources",
    "external_lists",
    "verification_status",
    "last_verified_at",
    "created_at",
    "updated_at",
    "scoring_model_version",
    "scores",
    "notes"
  ],
  "additionalProperties": false
}
