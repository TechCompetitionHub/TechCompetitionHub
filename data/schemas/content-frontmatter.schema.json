{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechCompetitionHub content-frontmatter",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "category": {
      "type": "string",
      "enum": [
        "guide",
        "retrospective",
        "announcement"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "draft": {
      "type": "boolean"
    },
    "related_competition_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "related_skill_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "title",
    "summary",
    "category",
    "tags",
    "author",
    "updated_at",
    "draft",
    "related_competition_ids",
    "related_skill_ids"
  ],
  "additionalProperties": false
}
