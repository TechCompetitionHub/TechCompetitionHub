{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechCompetitionHub project",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "is_example": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "domains": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "technologies": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "competition_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "repository_url": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "demo_url": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "documentation_url": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "team_contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "contributor_handle": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "contribution": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          },
          "consent_confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "contributor_handle",
          "contribution",
          "consent_confirmed"
        ],
        "additionalProperties": false
      }
    },
    "problem_statement": {
      "type": "string",
      "minLength": 20,
      "maxLength": 3000
    },
    "approach": {
      "type": "string",
      "minLength": 20,
      "maxLength": 4000
    },
    "reproducibility": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "run_steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "test_method": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        }
      },
      "required": [
        "environment",
        "dependencies",
        "run_steps",
        "test_method"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "string",
      "minLength": 10,
      "maxLength": 3000
    },
    "limitations": {
      "type": "string",
      "minLength": 10,
      "maxLength": 3000
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "verified",
        "stale",
        "rejected"
      ]
    },
    "submitted_by": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "last_verified_at": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "is_example",
    "id",
    "title",
    "summary",
    "domains",
    "technologies",
    "competition_ids",
    "repository_url",
    "demo_url",
    "documentation_url",
    "team_contributions",
    "problem_statement",
    "approach",
    "reproducibility",
    "results",
    "limitations",
    "license",
    "evidence_urls",
    "verification_status",
    "submitted_by",
    "last_verified_at",
    "created_at",
    "updated_at",
    "notes"
  ],
  "additionalProperties": false
}
