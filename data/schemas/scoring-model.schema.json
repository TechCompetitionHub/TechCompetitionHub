{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechCompetitionHub scoring-model",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "effective_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "dimensions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1000
          },
          "scoring_guidance": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "name",
          "weight",
          "description",
          "scoring_guidance"
        ],
        "additionalProperties": false
      }
    },
    "eligibility": {
      "type": "object",
      "properties": {
        "required_verification_status": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "draft",
              "needs_review",
              "verified",
              "stale",
              "rejected"
            ]
          }
        },
        "required_review_status": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "draft",
              "in_review",
              "approved"
            ]
          }
        },
        "min_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "require_all_dimensions": {
          "type": "boolean"
        },
        "min_score_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "required_verification_status",
        "required_review_status",
        "min_confidence",
        "require_all_dimensions",
        "min_score_coverage"
      ],
      "additionalProperties": false
    },
    "missing_data_policy": {
      "type": "string",
      "enum": [
        "exclude_from_official_ranking"
      ]
    },
    "tie_policy": {
      "type": "string",
      "enum": [
        "equal_scores_share_rank"
      ]
    },
    "changelog": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "change": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          }
        },
        "required": [
          "version",
          "date",
          "change"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "effective_from",
    "title",
    "description",
    "dimensions",
    "eligibility",
    "missing_data_policy",
    "tie_policy",
    "changelog"
  ],
  "additionalProperties": false
}
